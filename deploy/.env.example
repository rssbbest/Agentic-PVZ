# Copy to .env next to docker-compose.yml. Never commit the filled-in file.

# Public address. A domain pointing at the server, or <public-ip>.sslip.io,
# gets HTTPS automatically. ":80" = plain HTTP (local testing only).
SITE_ADDRESS=:80

# Organiser secrets (openssl rand -hex 16). Keep GATEWAY_TEAM_SECRET the same
# as before if team tokens were already handed out: tokens are derived from it.
ADMIN_SECRET=
SIMULATOR_SECRET=
EVENT_GATEWAY_TOKEN=
GATEWAY_TEAM_SECRET=
POSTGRES_PASSWORD=password

# LLM provider (Amazon Bedrock by default). Several keys: comma-separated.
AUTOPILOT_LLM_API_KEY=
#AUTOPILOT_LLM_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
#AUTOPILOT_LLM_MODEL=qwen.qwen3-next-80b-a3b-instruct
#AUTOPILOT_GATEWAY_RATE_PER_MIN=60

#AUTOPILOT_STARTING_COINS=3000
# true once the game has its login screen: play then also needs a login
#REQUIRE_LOGIN=false
#HTTP_PORT=80
# 127.0.0.1 keeps the ports private (e.g. behind the tunnel profile)
#BIND_ADDRESS=0.0.0.0
# tunnel: a Cloudflare quick tunnel gives an https://*.trycloudflare.com URL
#COMPOSE_PROFILES=tunnel
#HTTPS_PORT=443
