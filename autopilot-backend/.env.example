# Copy this file to .env and fill in real values
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/zombie_defense

# Where uploaded agent.py files are stored on disk
UPLOAD_DIR=./uploads

# SDK service base URL (running separately)
SDK_URL=http://localhost:8001
AUTOPILOT_REINFORCEMENT_TIMEOUT_SECONDS=3.5

# Simulator service base URL
SIMULATOR_URL=http://localhost:8002

# Evaluator service base URL
EVALUATOR_URL=http://localhost:8003

# Shared secret the simulator must send in the X-Simulator-Secret header
# when calling POST /runs/{id}/result
SIMULATOR_SECRET=change-me-in-production

# Organiser secret for X-Admin-Secret (POST /enemy_configs, POST /submissions/{id}/retry)
ADMIN_SECRET=change-me-in-production

# Max agent runs (SDK call + simulator start) in flight at once.
# Every submission is run against all enemy configs, so this throttles the fan-out.
MAX_CONCURRENT_RUNS=4

# NOTE: enemy data is NOT configured here. The backend owns it: 50 test
# configs are seeded into the database on first startup (see enemy_configs.py).
