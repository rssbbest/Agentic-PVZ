# Copy to .env. This file is loaded by integration.manage; no shell sourcing needed.
# Only the gateway process receives the provider key. Leave blank for baseline play.
# Any OpenAI-compatible endpoint works (Bedrock, Gemini, OpenAI, Ollama, vLLM, ...).
# BASE_URL is the OpenAI base URL without trailing /chat/completions.
# API_KEY may hold several keys separated by commas; the gateway rotates them
# and moves to the next key on 401/403/429.
# Default (quickstart.sh): Amazon Bedrock API key, Qwen, Mumbai region (lowest latency from India).
AUTOPILOT_LLM_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
AUTOPILOT_LLM_API_KEY=
AUTOPILOT_LLM_MODEL=qwen.qwen3-next-80b-a3b-instruct
# Gemini instead:
# AUTOPILOT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AUTOPILOT_LLM_MODEL=gemini-3.5-flash-lite

# Leave blank to generate private local secrets in .runtime/config.json.
POSTGRES_PASSWORD=
SIMULATOR_SECRET=
ADMIN_SECRET=

# Docker database settings. This stack has its own container and persistent volume.
POSTGRES_CONTAINER=autopilot-unified-db
POSTGRES_VOLUME=autopilot-unified-pgdata
POSTGRES_PORT=54339
MAX_CONCURRENT_RUNS=4

# Required for rebuilding real Unity players; set your installed editor executable.
# Linux example: /opt/unity/6000.1.17f1/Editor/Unity
UNITY_EDITOR_PATH=
# Optional: prebuilt Linux executable, with its adjacent Data directory and libraries.
UNITY_PLAYER_PATH=
# Optional compatibility library directory, if your Linux installation requires it.
UNITY_COMPAT_LIBS=
